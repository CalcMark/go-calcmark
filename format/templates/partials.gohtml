{{- /* Shared CalcMark template partials. All rendering logic lives here.
     Page templates (default.gohtml, preview.gohtml, custom) call these
     via {{template "cm-content" .}} or individual partials for layout control.

     Available partials:
       cm-content     — frontmatter + all blocks (most consumers use this)
       cm-frontmatter — frontmatter section only
       cm-blocks      — all blocks (calc + text) with diagnostics
       cm-calc-block  — single calculation block with per-line results/errors
       cm-text-block  — single text block with warnings
*/ -}}

{{define "cm-frontmatter"}}
{{- if .Frontmatter}}
    <section class="frontmatter" aria-label="Document configuration">
        {{if .Frontmatter.Globals}}
        <h3>Globals</h3>
        <dl>
            {{range .Frontmatter.Globals}}
            <dt>{{.Name}}</dt>
            <dd>{{.Value}}</dd>
            {{end}}
        </dl>
        {{end}}
        {{if and .Frontmatter.Globals .Frontmatter.Exchange}}<hr>{{end}}
        {{if .Frontmatter.Exchange}}
        <h3>Exchange Rates</h3>
        <dl class="exchange">
            {{range .Frontmatter.Exchange}}
            <dt>{{.From}} → {{.To}}</dt>
            <dd>{{.Rate}}</dd>
            {{end}}
        </dl>
        {{end}}
        {{if .Frontmatter.Scale}}
        <h3>Scale</h3>
        <p class="frontmatter-value">{{.Frontmatter.Scale}}</p>
        {{end}}
        {{if .Frontmatter.ConvertTo}}
        <h3>Convert To</h3>
        <p class="frontmatter-value">{{.Frontmatter.ConvertTo}}</p>
        {{end}}
        {{if .Frontmatter.FiscalYearStarts}}
        <h3>Fiscal Year Starts</h3>
        <p class="frontmatter-value">{{.Frontmatter.FiscalYearStarts}}</p>
        {{end}}
        {{if .Frontmatter.Extra}}
        <hr>
        <dl class="extra">
            {{range .Frontmatter.Extra}}
            <dt>{{.Key}}</dt>
            <dd>{{.Value}}</dd>
            {{end}}
        </dl>
        {{end}}
    </section>
{{- end}}
{{end}}

{{define "cm-calc-block"}}
    <div class="calc-block" data-source-line="{{.DocLine}}">
        {{range $i, $line := .SourceLines}}
        <div class="calc-line{{if $line.Error}} calc-line-error{{end}}{{if $line.IsCascading}} calc-line-cascading{{end}}" data-source-line="{{$line.DocLine}}">
            <code class="calc-source">{{$line.Source}}</code>
            {{if $line.Result}}
            <span class="calc-inline-result">{{$line.Result}}</span>
            {{end}}
        </div>
        {{- if $line.Error}}
        <div class="calc-line-diagnostic{{if $line.IsCascading}} calc-cascading{{end}}">{{$line.Error}}</div>
        {{- end}}
        {{end}}
        {{if and .Error (not .HasLineDiagnostic)}}
        <div class="calc-error"><strong>Error:</strong> {{.Error}}</div>
        {{end}}
    </div>
{{end}}

{{define "cm-text-block"}}
    <div class="text-block" data-source-line="{{.DocLine}}">{{.HTML}}{{range .Warnings}}
    <div class="calc-warning"><strong>Warning:</strong> {{.}}</div>
    {{end}}</div>
{{end}}

{{define "cm-blocks"}}
{{- range .Blocks}}
    {{if eq .Type "calculation"}}
    {{template "cm-calc-block" .}}
    {{else}}
    {{template "cm-text-block" .}}
    {{end}}
{{- end}}
{{end}}

{{define "cm-content"}}
{{template "cm-frontmatter" .}}
{{template "cm-blocks" .}}
{{end}}
