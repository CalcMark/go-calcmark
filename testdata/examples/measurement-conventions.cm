# UK Baking: Victoria Sponge

## Ingredients (serves 8)
butter = 8 oz
sugar = 8 oz
flour = 8 oz
eggs = 4
milk = 2 fl oz

## Cost
butter_cost = $4.50
sugar_cost = $2.00
flour_cost = $1.80
egg_cost = $3.20
milk_cost = $0.50
total_cost = sum of butter_cost, sugar_cost, flour_cost, egg_cost, milk_cost
cost_per_serving = total_cost / 8

## Unit Check
milk_in_ml = milk in ml
flour_in_grams = flour in grams
