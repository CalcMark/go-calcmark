# Investment Growth

## Retirement Savings
initial_savings = $50000
annual_return = 7%
years_to_retire = 30

# Simple compound growth — NL form with variable references
retirement_fund = compound initial_savings by annual_return over years_to_retire

# With monthly compounding (higher return)
retirement_monthly = compound initial_savings by annual_return compounded monthly over 30 years

## Business Growth

# Customer base growing 15% per month
starting_customers = 500 customers
monthly_growth = compound starting_customers by 15% over 24

# Natural language form
compound 1000 users by 10% over 12

## Linear Growth

# Adding $200/month to savings for 5 years
savings_plan = grow $0 by $200 over 60

# Adding 50 subscribers per week
grow 100 subscribers by 50 over 52

## Asset Depreciation

# Car loses 20% per year
car_value = depreciate $35000 by 20% over 5

# Equipment with $2000 salvage floor
depreciate $80000 by 25% over 10 to $2000

# Office furniture
furniture = depreciate $15000 by 15% over 7
