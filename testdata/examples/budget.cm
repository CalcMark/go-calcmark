# Monthly Budget

## Income
salary = $5000
side_hustle = $800
total_income = salary + side_hustle

## Fixed Expenses
rent = $1500
utilities = $200
insurance = $150
fixed_total = rent + utilities + insurance

## Savings Target
savings_rate = 0.20
savings = total_income * savings_rate

## Discretionary
remaining = total_income - fixed_total - savings
