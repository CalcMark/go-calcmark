---
scale:
  factor: 4
  unit_categories: [Mass, Volume, Custom]
---
# Scale fractions by 4x

# Fraction with custom unit — scaled (Custom in unit_categories)
half_tomato = 1/2 tomato
third_avocado = 1/3 avocado

# Fraction with known unit — scaled (Volume in unit_categories)
quarter_cup = 1/4 cup
third_cup = 1/3 cup

# Dimensionless fraction — not scaled (Number not in unit_categories)
ratio = 1/4

# Mixed number with unit — scaled
mixed = 2 1/3 cups
