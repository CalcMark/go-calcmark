# Fractions

## Simple fractions
a = 1/3
b = 2/3
c = 7/8

## Fraction arithmetic
d = 1/3 + 1/3
e = 1/3 + 1/4
f = 2/3 - 1/3
g = 1/3 * 3
h = 2/3 * 3/4

## Exact precision
i = 1/3 + 1/3 + 1/3

## Mixed numbers
j = 7/3

## Simplification
k = 2/4

## Fraction with unit
l = 1/3 cup

## Negative fraction
m = -1/3

## Fraction as scalar multiplier
n = 1/2 * 100

## Variable propagation
p = a + a

## Division with spaces is still division
q = 1 / 3
