---
scale:
  factor: 4
  unit_categories: [Mass, Volume]
---
# Scale Mass and Volume by 4x

flour = 280 grams
butter = 100 grams
water = 500 ml

# Custom units — not scaled (Custom not in unit_categories)
eggs = 3 eggs

# Temperature not in unit_categories — not scaled
oven_temp = 220 celsius

# Currency is not in unit_categories — not scaled
price = $100

# Duration is immune to scale
bake_time = 30 minutes
