# Test: Undo/Redo behavior
# Verifies: Ctrl+Z undoes, Ctrl+Y redoes, cursor restoration
# Document: # Header\nx = 10\ny = 20\nz = 30 (4 lines)
# IMPORTANT: Each test block is cumulative - state persists between blocks

# Test 1: basic_undo - type text then undo
# Initial: cursor at line 0, col 0, line content is "# Header"
run observe=debug
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Type "abc" at the beginning of line 0
run observe=debug
type abc
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=3 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="abc# Header" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Force boundary by navigating, then undo - should restore to original "# Header"
run observe=debug
key down
key ctrl+z
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 2: redo - Ctrl+Y should restore the undone text
run observe=debug
key ctrl+y
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=3 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="abc# Header" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Undo again to get back to original
run observe=debug
key ctrl+z
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 3: new edit clears redo stack
# Type "xyz" then try to redo (should have no effect since redo stack is cleared)
run observe=debug
type xyz
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=3 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="xyz# Header" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Redo should have no effect (redo stack was cleared by the new edit)
run observe=debug
key down
key ctrl+y
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=3 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="x = 10" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true
