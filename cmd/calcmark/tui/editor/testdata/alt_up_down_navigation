# Test Alt+Up/Down for document boundary navigation (Terminal.app fallback)
# Alt+Up = document start, Alt+Down = document end

# Setup: cursor at middle of multi-line document
run observe=debug
key down
key down
key right
key right
----
-- debug:
mode=StateDefault cursorLine=2 cursorCol=2 cursorVisual=2 cursorHighlight=2 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="y = 20" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Alt+Up should jump to document start (line 0, col 0)
run observe=debug
key alt+up
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Move to middle again
run observe=debug
key down
key down
key right
key right
----
-- debug:
mode=StateDefault cursorLine=2 cursorCol=2 cursorVisual=2 cursorHighlight=2 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="y = 20" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Alt+Down should jump to document end (last line, end of line)
run observe=debug
key alt+down
----
-- debug:
mode=StateDefault cursorLine=3 cursorCol=6 cursorVisual=3 cursorHighlight=3 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="z = 30" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Alt+Up from document end should go back to start
