# Context Footer Variable References Integration Test
# Verifies that the context footer shows variable references as the user
# navigates between lines with arrow keys.

# Step 1: Initial state — cursor on "rent = 1500" (line 0, no refs)
run observe=debug
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Step 2: Check footer on line 0 (defines rent, references nothing)
run observe=footer
----
-- footer:
(empty)

# Step 3: Navigate down to "utils = 200" (line 1)
run observe=debug
key down
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=0 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="utils = 200" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Step 4: Footer on line 1 (defines utils, references nothing)
run observe=footer
----
-- footer:
(empty)

# Step 5: Navigate down to "total = rent + utils" (line 2)
run observe=debug
key down
----
-- debug:
mode=StateDefault cursorLine=2 cursorCol=0 cursorVisual=2 cursorHighlight=2 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="total = rent + utils" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Step 6: Footer on line 2 — should show rent and utils references
run observe=footer
----
-- footer:
rent = 1.5K │ utils = 200

# Step 7: Navigate down to "savings = total * 0.10" (line 3)
run observe=debug
key down
----
-- debug:
mode=StateDefault cursorLine=3 cursorCol=0 cursorVisual=3 cursorHighlight=3 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="savings = total * 0.10" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Step 8: Footer on line 3 — should show total reference
run observe=footer
----
-- footer:
total = 1.7K
