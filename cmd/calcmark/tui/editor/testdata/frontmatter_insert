# Test: Insert Frontmatter via Ctrl+F
# Verifies: Ctrl+F inserts default frontmatter with exchange rates and globals,
# second Ctrl+F is no-op with status message

# Initial state - no frontmatter, 3 calc lines
run observe=frontmatter
----
-- frontmatter:
hasFrontmatter=false
frontmatterLineCount=0
totalLines=3
statusMsg=""

# Press Ctrl+F to insert frontmatter
run observe=frontmatter
command Insert Frontmatter
----
-- frontmatter:
hasFrontmatter=true
frontmatterLineCount=10
totalLines=13
statusMsg="Frontmatter inserted"
globalsCount=1

# Verify cursor is on the exchange rate line (line 2)
run observe=debug
----
-- debug:
