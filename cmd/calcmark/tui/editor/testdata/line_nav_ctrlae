# Test: Ctrl+A and Ctrl+E readline-style line navigation
# Verifies: NAV-03 (Ctrl+A -> line start) and NAV-04 (Ctrl+E -> line end)

# Initial state - cursor at line 0, col 0
run observe=debug
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 1: Ctrl+A at column 0 stays at column 0
run observe=debug
key ctrl+a
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 2: Move to end of line first using End
run observe=debug
key end
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=8 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 3: Ctrl+A moves from end to column 0 (like Home)
run observe=debug
key ctrl+a
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 4: Ctrl+E moves from column 0 to end of line (like End)
run observe=debug
key ctrl+e
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=8 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test 5: Ctrl+E at end of line stays at end
run observe=debug
key ctrl+e
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=8 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

