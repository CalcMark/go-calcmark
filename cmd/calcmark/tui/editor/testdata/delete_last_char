# Test: DELETE key removes last remaining character on a line
# Reproduces user scenario: single character on line, DELETE should remove it
# This test documents the exact behavior for regression prevention

# Initial state - cursor at line 0, col 0 with document containing single "a"
run observe=debug
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=1 totalVisual=1 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Press DELETE to remove the 'a' at cursor position
# editBuf should load "a" via transitionToEditing, then delete it, leaving ""
run observe=debug
key delete
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=1 totalVisual=1 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true
