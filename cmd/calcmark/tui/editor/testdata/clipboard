# Test Ctrl+X cut - document should be empty after cutting all text
run observe=lines
key cmd+a
key ctrl+x
----
-- lines:
sourceToVisual: map[0:0]
Visual lines:
  [0] srcIdx=0 lineNum=1 wrap=false pad=false content="# Header" <CURSOR>


