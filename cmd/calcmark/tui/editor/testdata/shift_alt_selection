# Test Shift+Alt+Up/Down for selection extension to document boundaries
# Also tests Shift+Ctrl+Up/Down (same behavior via unified dispatch)

# Move cursor to middle of document
run observe=debug
key down
key down
key right
key right
----
-- debug:
mode=StateDefault cursorLine=2 cursorCol=2 cursorVisual=2 cursorHighlight=2 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="y = 20" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Shift+Alt+Up should select from cursor to document start
run observe=debug
key shift+alt+up
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="# Header" selectionAnchorLine=2 selectionAnchorCol=2 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Clear selection and move back to middle
run observe=debug
key down
key down
key right
key right
----
-- debug:
mode=StateDefault cursorLine=2 cursorCol=2 cursorVisual=2 cursorHighlight=2 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="y = 20" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Shift+Alt+Down should select from cursor to document end
run observe=debug
key shift+alt+down
----
