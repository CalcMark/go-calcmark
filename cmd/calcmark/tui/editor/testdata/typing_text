# Test: Basic text typing behaviors
# Verifies: Characters appear correctly, backspace deletes, delete key works, cursor advances

# Initial state - cursor at line 0, col 0
run observe=debug
----
-- debug:
mode=0 cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Type some text at beginning of line (appends to editBuf)
run observe=debug
type hello
----
-- debug:
mode=0 cursorLine=0 cursorCol=5 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="hello# Test Document" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Backspace should delete last character
run observe=debug
key backspace
----
-- debug:
mode=0 cursorLine=0 cursorCol=4 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="hell# Test Document" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Continue typing more
run observe=debug
type world
----
-- debug:
mode=0 cursorLine=0 cursorCol=9 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="hellworld# Test Document" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Test delete key (forward delete)
run observe=debug
key home
key delete
----
-- debug:
mode=0 cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="ellworld# Test Document" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Delete again to verify forward deletion works
run observe=debug
key delete
----
-- debug:
mode=0 cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="llworld# Test Document" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Escape commits and clears editBuf
run observe=debug
key esc
----
-- debug:
mode=0 cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="llworld# Test Document" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Navigate to next line and type
run observe=debug
key down
type test
----
-- debug:
mode=0 cursorLine=1 cursorCol=4 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=3 totalVisual=3 editBuf="testx = 10" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true
