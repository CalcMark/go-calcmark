# Test that F1 toggles command menu overlay
# Verifies: F1 opens command menu, F1/Esc closes it, editing continues after

# Initial state - cursor at line 0, col 0, normal mode
run observe=debug
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Press F1 to open command menu
run observe=debug
key f1
----
-- debug:
mode=StateCommandMenu cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Press F1 again to close command menu
run observe=debug
key f1
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Open command menu with F1, close with Escape
run observe=debug
key f1
key esc
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Verify normal editing after command menu closes
run observe=lines
key f1
key esc
type = 1 + 1
----
-- lines:
sourceToVisual: map[0:0 1:1 2:2 3:3]
Visual lines:
  [0] srcIdx=0 lineNum=1 wrap=false pad=false content="= 1 + 1# Header" <CURSOR>
  [1] srcIdx=1 lineNum=2 wrap=false pad=false content="x = 10"
  [2] srcIdx=2 lineNum=3 wrap=false pad=false content="y = 20"
  [3] srcIdx=3 lineNum=4 wrap=false pad=false content="z = 30"
