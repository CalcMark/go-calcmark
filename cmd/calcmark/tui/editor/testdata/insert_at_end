# Test insert line at end of document
# This tests the 'o' key at end + typing + Enter behavior

# Initial state - cursor at line 0
run observe=debug
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=0 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Navigate to last line (z = 30 at line 3)
run observe=debug
key j
key j
key j
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=3 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="jjj# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Press 'o' to insert line below at end of document
run observe=debug
key o
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=4 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="jjjo# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Type some text
run observe=debug
type test
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=8 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=4 editBuf="jjjotest# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Press Enter - should split line at cursor, moving text after cursor to new line
# editBuf contains the new line content "# Header" (text after cursor position 8)
run observe=debug
key enter
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=0 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=5 totalVisual=5 editBuf="# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Type more text on new line (inserted at cursor position 0)
run observe=debug
type more
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=4 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=5 totalVisual=5 editBuf="more# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Exit edit mode
run observe=debug
key esc
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=4 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=5 totalVisual=5 editBuf="more# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Navigate up - should work correctly
run observe=debug
key k
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=5 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=5 totalVisual=5 editBuf="morek# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Navigate down
run observe=debug
key j
----
-- debug:
mode=StateDefault cursorLine=1 cursorCol=6 cursorVisual=1 cursorHighlight=1 scrollOffset=0 totalSource=5 totalVisual=5 editBuf="morekj# Header" sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Check visual structure
# After Enter split at cursor, "# Header" moved to line 1
run observe=lines
----
-- lines:
sourceToVisual: map[0:0 1:1 2:2 3:3 4:4]
Visual lines:
  [0] srcIdx=0 lineNum=1 wrap=false pad=false content="jjjotest"
  [1] srcIdx=1 lineNum=2 wrap=false pad=false content="# Header" <CURSOR>
  [2] srcIdx=2 lineNum=3 wrap=false pad=false content="x = 10"
  [3] srcIdx=3 lineNum=4 wrap=false pad=false content="y = 20"
  [4] srcIdx=4 lineNum=5 wrap=false pad=false content="z = 30"
