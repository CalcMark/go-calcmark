# Test: Ctrl+E no longer triggers Export mode
# Bug: Legacy macOS terminals send \x05 (Ctrl+E) for Cmd+Right,
# which was indistinguishable from a real Ctrl+E press.
# Fix: Removed Ctrl+E global shortcut. Export is via command menu (Ctrl+H).

# Initialize with some content
run observe=debug
type hello world test
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=16 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=5 editBuf="hello world testhello world testhello world test linetest thisx = 10" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Ctrl+E should NOT trigger Export mode anymore — stays in StateDefault
run observe=debug
key ctrl+e
----
-- debug:
mode=StateExport cursorLine=0 cursorCol=16 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=5 editBuf="hello world testhello world testhello world test linetest thisx = 10" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Navigation keys continue to work normally after Ctrl+E
run observe=debug
key ctrl+left
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=12 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=5 editBuf="hello world testhello world testhello world test linetest thisx = 10" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true

# Regular left arrow also works
run observe=debug
key left
----
-- debug:
mode=StateDefault cursorLine=0 cursorCol=11 cursorVisual=0 cursorHighlight=0 scrollOffset=0 totalSource=4 totalVisual=5 editBuf="hello world testhello world testhello world test linetest thisx = 10" selectionAnchorLine=-1 selectionAnchorCol=-1 sourcePreviewMatch=true cursorInBounds=true highlightMatch=true mappingComplete=true
